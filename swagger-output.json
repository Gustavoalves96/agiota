          "valor": {
            "type": "number",
            "example": 300
          },
          "forma": {
            "type": "string",
            "example": "PIX"
          },
          "data": {
            "type": "string",
            "example": "2026-10-25"
          }
        },
        "required": [
          "emprestimoId",
          "valor",
          "forma"
        ],
        "xml": {
          "name": "Pagamento"
        }
      }
    }
  }
