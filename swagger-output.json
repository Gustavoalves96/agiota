        }
      },
      "Emprestimo": {
        "type": "object",
        "properties": {
          "clienteId": {
            "type": "number",
            "example": 1
          },
          "cobradorId": {
            "type": "number",
            "example": 1
          },
          "valor": {
            "type": "number",
            "example": 1000
          },
          "vencimento": {
            "type": "string",
            "example": "2026-11-21"
          },
          "data": {
            "type": "string",
            "example": "2026-10-21"
          }
        },
        "required": [
          "clienteId",
          "cobradorId",
          "valor",
          "vencimento"
        ],
        "xml": {
          "name": "Emprestimo"
        }
